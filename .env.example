# COE SYNC 2026 - Environment Configuration Example
# Copy this file to coe_sync/.env and configure for your local or production environment.

# Flask Environment Settings
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=dev-secret-key-coe-sync-2026-bulsu-college-of-engineering

# Database Connection URI
# 1. Local SQLite Default (Zero-config, with foreign key integrity enabled)
DATABASE_URL=sqlite:///coe_sync.db

# 2. MySQL / MariaDB Production Configuration Example:
# DATABASE_URL=mysql+pymysql://coe_user:coe_password@localhost:3306/coe_sync_db?charset=utf8mb4

# Server Port
PORT=5000
